{
	"name": "@ver0/deep-equal",
	"version": "0.0.0",
	"description": "Deep values comparator for JS",
	"keywords": [
		"assert",
		"deep-equal",
		"equal",
		"equality",
		"value"
	],
	"bugs": {
		"url": "https://github.com/ver0-project/deep-equal/issues"
	},
	"license": "MIT",
	"author": "Anton Zinovyev <xog3@yandex.ru>",
	"repository": {
		"type": "git",
		"url": "https://github.com/ver0-project/deep-equal"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "dist/is-equal.js",
	"types": "dist/is-equal.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "yarn build:clean && tsc --version && tsc -p tsconfig.build.json",
		"build:clean": "rimraf dist",
		"fmt": "vp fmt --write",
		"fmt:check": "vp fmt --check",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"test": "vp test --run",
		"test:coverage": "vp test --run --coverage",
		"benchmark": "vp test bench --run"
	},
	"devDependencies": {
		"@types/deep-equal": "^1.0.4",
		"@ver0/oxlint-config": "^2.0.2",
		"@vitest/coverage-v8": "^4.1.8",
		"deep-equal": "^2.2.3",
		"dequal": "^2.0.3",
		"fast-deep-equal": "^3.1.3",
		"oxlint": "^1.75.0",
		"oxlint-tsgolint": "^7.0.2001",
		"react-fast-compare": "^3.2.2",
		"rimraf": "^6.1.3",
		"semantic-release": "^25.0.3",
		"typescript": "^7.0.2",
		"vite-plus": "^0.2.6",
		"vitest": "^4.1.8"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "yarn@4.17.1"
}
